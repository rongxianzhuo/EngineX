<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);ENGINEX_SAFETY_CHECKS</DefineConstants>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>EngineX.Jobs.Tests</AssemblyName>
    <RootNamespace>EngineX.Jobs.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Jobs/**/*.cs" Link="EngineX/Jobs/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
